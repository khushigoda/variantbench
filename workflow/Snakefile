# VariantBench — Snakemake workflow
# Config-driven: metabolites, cohorts, outcomes all come from config/config.yaml.
# Run from the repo ROOT (recommended so results/ land at the top level):
#   cd ~/variantbench && snakemake -n
# Draw it:        snakemake --dag | dot -Tsvg > dag.svg
# Build:          snakemake --cores 4
#
# Config path is resolved RELATIVE TO THIS Snakefile (workflow.basedir/../config),
# so the "configfile not present" error can't happen no matter where you invoke from.
import os
configfile: os.path.normpath(os.path.join(workflow.basedir, "..", "config", "config.yaml"))

# ---------- derived lists from config ----------
METABOLITES = list(config["metabolites"].keys())
COHORTS     = config["cohorts"]
OUTCOMES    = list(config["outcomes"].keys())
META        = config["meta_name"]
DATASETS    = config["ldsc_datasets"]   # Step-2 rg datasets: [EstBB, UKBB_EUR, meta_EUR]
# Step-2 trait subset: run LDSC on just these traits (defaults to ALL if not set in config).
# Lets you run a fast subset (e.g. [BCAA, Lactate]) without touching Step-1 METABOLITES.
LDSC_METABOLITES = config.get("ldsc_metabolites", METABOLITES)

# NOTE (scope: Steps 0-2 today). Steps 3-8 are deferred and live in a commented block
# at the bottom of this file. They depend on config keys that are intentionally still
# commented out (ref.geno_panel, ref.eqtl_dataset, metabolites.*.cis_genes/coloc_locus);
# restore those in config/config.yaml and un-comment the block to extend the DAG.
# CIS_PAIRS = [(m, g) for m in METABOLITES for g in config["metabolites"][m]["cis_genes"]]

# Constrain wildcards to their known vocabularies so metabolite/cohort/meta patterns
# can't cross-match while Snakemake explores the DAG.
wildcard_constraints:
    metabolite = "|".join(METABOLITES),
    cohort     = "|".join(COHORTS),
    outcome    = "|".join(OUTCOMES),
    metab      = "|".join(METABOLITES),
    dataset    = "|".join(DATASETS)

# ---------- helpers to resolve raw input paths ----------
def metab_raw_file(metabolite, cohort):
    """Raw per-cohort metabolite sumstats path (GWAS-SSF, as downloaded)."""
    acc = config["metabolites"][metabolite]["accession"][cohort]
    return f"data/raw/{metabolite}_{cohort}.{acc}.tsv.gz"

def raw_by_tag(metabolite, tag):
    """Raw per-tag sumstats path; tag is a cohort (EstBB/UKBB_EUR) or the meta accession."""
    acc = config["metabolites"][metabolite]["accession"][tag]
    return f"data/raw/{metabolite}_{tag}.{acc}.tsv.gz"

def ldsc_dataset_input(metabolite, dataset):
    """Step-2 munge input for a (trait, dataset) pair, and the adapter 'kind' it needs.
    EstBB / UKBB_EUR  -> raw per-cohort GWAS-SSF   (kind=raw:  carries info -> INFO>=0.9 fires)
    meta_EUR          -> OUR Step-1 meta output    (kind=meta: no info col -> HM3+MAF only).
    Returns (path, kind)."""
    if dataset == "meta_EUR":
        return f"results/meta/{metabolite}.meta.tsv.gz", "meta"
    return raw_by_tag(metabolite, dataset), "raw"

# Columns each raw file contributes to its per-chr split (1-based GWAS-SSF positions).
# Cohorts carry rsid (col 9) + n (col 13); the published meta has no rsid, n is col 11.
SPLIT_COLS = {
    "EstBB":    "1,2,3,4,5,6,7,9,13",
    "UKBB_EUR": "1,2,3,4,5,6,7,9,13",
    "metaEUR":  "1,2,3,4,5,6",   # validation join needs only chr,pos,ea,oa,beta,se
}

def meta_inputs(wildcards):
    """Step 1 (GENOME-WIDE, chr-streamed) reads PER-CHROMOSOME split dirs for the two
    EUR cohorts + the published meta (validation). The split (rule split_by_chr) is a
    one-decompression-pass Step-0 that makes per-chromosome reads cheap on 8 GB."""
    m = wildcards.metabolite
    return {
        "est_dir":  f"results/split/{m}_EstBB",
        "ukbb_dir": f"results/split/{m}_UKBB_EUR",
        "val_dir":  f"results/split/{m}_{config['meta_name']}",   # published meta_EUR
    }

# =========================================================
# Step 0 — schema INSPECTION is intentionally NOT a rule.
# It produces no file that Steps 1/2 consume; its findings travel as decisions baked
# into 01/02's code. Run it once, by hand, and commit results/inspect/00_findings.md:
#     Rscript workflow/scripts/00_inspect.R
# =========================================================

# =========================================================
# rule all — today's targets: Step 1 (meta + validation) and Step 2 (LDSC h2/rg)
# =========================================================
rule all:
    input:
        # Step 1 meta + concordance + validation-vs-published
        expand("results/meta/{metab}.meta.tsv.gz",      metab=METABOLITES),
        expand("results/meta/{metab}.concordance.png",  metab=METABOLITES),
        expand("results/meta/{metab}.validation.png",   metab=METABOLITES),
        expand("results/meta/{metab}.validation.tsv",   metab=METABOLITES),
        # Step 2 LDSC — 3 datasets x LDSC_METABOLITES (paper replication)
        expand("results/ldsc/{metab}.{dataset}.h2.log", metab=LDSC_METABOLITES, dataset=DATASETS),
        "results/ldsc/h2.tsv",
        "results/ldsc/rg_between_biobanks.tsv",   # Analysis A: 3 datasets, per trait
        "results/ldsc/rg_between_traits.tsv",     # Analysis B: traits within each dataset
        "results/ldsc/h2_barplot.png",
        "results/ldsc/rg_between_biobanks.png",
        "results/ldsc/rg_between_traits.png",
        # Step 3 lead variants + Manhattan (per trait)
        expand("results/loci/{metab}.lead.tsv",      metab=METABOLITES),
        expand("results/loci/{metab}.manhattan.png", metab=METABOLITES),
        # Step 4a LD-matrix prep (only the traits configured for fine-mapping)
        expand("results/ld/{metab}.loci.tsv",        metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/ld/{metab}.ld_manifest.tsv", metab=config["ld_prep"]["finemap_metabolites"]),
        # Step 4c fine-mapping (SuSiE) — traits configured for fine-mapping
        expand("results/finemap/{metab}.finemap.tsv",            metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/finemap/{metab}.cs_summary.tsv",         metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/finemap/{metab}.cs_summary.filtered.tsv",metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/finemap/{metab}.susie_qc.tsv",           metab=config["ld_prep"]["finemap_metabolites"]),
        # Step 4d annotation (VEP missense) — traits configured for fine-mapping
        expand("results/finemap/{metab}.annot.tsv",          metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/finemap/{metab}.annot.missense.tsv", metab=config["ld_prep"]["finemap_metabolites"]),
        # Step 4e report figures
        expand("results/finemap/{metab}.finemap_summary.png",     metab=config["ld_prep"]["finemap_metabolites"]),
        expand("results/finemap/{metab}.consequence_summary.png", metab=config["ld_prep"]["finemap_metabolites"])

# =========================================================
# Step 1 — meta-analysis (EstBB + UKBB_EUR -> meta), reads RAW files directly
# =========================================================
rule split_by_chr:
    """Step 0 (prepare): one-pass decompress a raw .tsv.gz into per-chromosome files,
    keeping only the columns Step 1 needs. gzip is not seekable, so this converts each
    raw file ONCE instead of re-decompressing it per chromosome in the meta loop.
    Output is a directory of chrN.tsv.gz (+ a .done marker)."""
    input:  lambda w: raw_by_tag(w.metabolite, w.tag)
    # temp(): the per-chr split dir is a transient intermediate — read once by
    # meta_analysis, then auto-deleted by Snakemake as soon as that job finishes.
    # Keeps disk flat (~one trait's splits at a time) with no manual rm; on a meta
    # FAILURE Snakemake keeps the splits so a re-run skips re-splitting.
    output: temp(directory("results/split/{metabolite}_{tag}"))
    params: cols=lambda w: SPLIT_COLS[w.tag]
    wildcard_constraints: tag="EstBB|UKBB_EUR|metaEUR"
    shell:  "bash scripts/00_split_by_chr.sh {input} {output} {params.cols}"

rule meta_analysis:
    input:  unpack(meta_inputs)
    output:
        meta="results/meta/{metabolite}.meta.tsv.gz",
        plot="results/meta/{metabolite}.concordance.png",
        valplot="results/meta/{metabolite}.validation.png",
        valtsv="results/meta/{metabolite}.validation.tsv"
    params: seed=config["params"]["seed"], gws_p=config["params"]["gws_p"]
    conda:  config["envs"]["r"]
    script: "scripts/01_meta.R"

# =========================================================
# Step 2 — heritability & genetic correlation (LDSC, Python-2 env)
# =========================================================
rule ldsc_munge:
    # One munge job per (trait, dataset) = 3 x 4 = 12 jobs. munge does the QC itself:
    #   - --merge-alleles w_hm3.snplist  -> HapMap3 restriction + allele harmonisation
    #     (flip-align to the HM3 reference, drop strand-ambiguous / mismatched variants).
    #   - default --maf-min 0.01 fires because we name the freq column FRQ (auto-detected).
    #   - default --info-min 0.9 fires ONLY for the raw cohorts, which carry an INFO column;
    #     meta_EUR has no INFO col (kind=meta) so INFO filtering is n/a there, by design.
    # The adapter (scripts/ldsc_munge_input.sh) is a FORMAT bridge + HapMap3 pre-restriction.
    # It fixes the three things munge can't (neg_log10(P) -> real P with 1e-300 floor, N as
    # float since Py2.7 pandas rejects an integer N column, canonical column names) AND filters
    # to the ~1.2M HapMap3 rsIDs FIRST via a streaming awk join against w_hm3.snplist.
    # WHY pre-restrict: the raw cohorts are genome-wide (26-104M variants). If munge sees the
    # full file it parses every row into a Py2.7 pandas DataFrame BEFORE --merge-alleles drops
    # the ~99% non-HM3 rows. Feeding it a ~1.2M-row HM3-restricted file avoids that.
    #
    # WHY --chunksize 200000: munge's default chunksize (5e6) exceeds our ~1.2M-row HM3 file, so
    # the default processes it as ONE chunk and runs the --merge-alleles membership test
    #   ii = dat.SNP.isin(merge_alleles.SNP)          # munge_sumstats.py parse_dat
    # once over a 1.2M-vs-1.2M string Series. Under LDSC's pinned pandas 0.20.3 that single
    # large-vs-large isin is super-linear (sort-based np.in1d, Python-level string compares).
    # Processing in 200k-row chunks runs the same test in small batches -- 7 x isin(200k) is far
    # cheaper than 1 x isin(1.2M) -- reducing each munge job to ~20s. Any chunksize above 1.2M has
    # no effect (still one chunk), so 200k is the load-bearing value.
    #
    # Result is IDENTICAL regardless of chunk size: --merge-alleles STILL runs (allele harmonise
    # + strand-ambiguous drop) and the FRQ/INFO QC defaults STILL fire; chunking only changes
    # how the rows are batched through pandas. Signed statistic = BETA (paired with P), authors.
    input:  lambda w: ldsc_dataset_input(w.metabolite, w.dataset)[0]
    output: "results/ldsc/{metabolite}.{dataset}.sumstats.gz"
    params:
        hm3=config["ref"]["hm3_snplist"],
        ldsc_env=config["envs"]["ldsc"],
        kind=lambda w: ldsc_dataset_input(w.metabolite, w.dataset)[1]
    shell:
        r"""
        mkdir -p results/ldsc
        mungein=results/ldsc/{wildcards.metabolite}.{wildcards.dataset}.mungein.tsv.gz
        bash scripts/ldsc_munge_input.sh {params.kind} {input} $mungein {params.hm3}
        conda run -n {params.ldsc_env} python ~/ldsc/munge_sumstats.py \
            --sumstats $mungein --merge-alleles {params.hm3} \
            --out results/ldsc/{wildcards.metabolite}.{wildcards.dataset} \
            --snp SNP --a1 A1 --a2 A2 --N-col N --signed-sumstats BETA,0 --p P \
            --chunksize 200000
        rm -f $mungein
        """

rule ldsc_h2:
    input:  "results/ldsc/{metabolite}.{dataset}.sumstats.gz"
    output: "results/ldsc/{metabolite}.{dataset}.h2.log"
    params: ld=config["ref"]["ld_scores"], ldsc_env=config["envs"]["ldsc"]
    shell:
        r"""
        mkdir -p results/ldsc
        conda run -n {params.ldsc_env} python ~/ldsc/ldsc.py \
            --h2 {input} --ref-ld-chr {params.ld} --w-ld-chr {params.ld} \
            --out results/ldsc/{wildcards.metabolite}.{wildcards.dataset}.h2
        """

rule ldsc_rg:
    # Both paper analyses in one R step, over the 12 munged files:
    #   A (between biobanks, per trait): for each trait, staircase-rg the 3 datasets -> 12 rg
    #   B (between traits, per dataset): for each dataset, staircase-rg the 4 traits -> 18 rg
    # The R script drives ldsc.py --rg (ldsc env) and parses the h2 + rg logs into tidy TSVs.
    input:
        sumstats=expand("results/ldsc/{metab}.{dataset}.sumstats.gz",
                        metab=LDSC_METABOLITES, dataset=DATASETS),
        h2=expand("results/ldsc/{metab}.{dataset}.h2.log",
                  metab=LDSC_METABOLITES, dataset=DATASETS)
    output:
        h2="results/ldsc/h2.tsv",                              # parsed h2 + SE + intercept (12 rows)
        rg_bb="results/ldsc/rg_between_biobanks.tsv",          # Analysis A (12 rg)
        rg_tr="results/ldsc/rg_between_traits.tsv",            # Analysis B (18 rg)
        h2_plot="results/ldsc/h2_barplot.png",                 # h2 +/- SE, faceted by dataset
        rg_bb_plot="results/ldsc/rg_between_biobanks.png",     # per-trait 3x3 biobank heatmaps
        rg_tr_plot="results/ldsc/rg_between_traits.png"        # per-dataset 4x4 trait heatmaps
    params:
        seed=config["params"]["seed"], ld=config["ref"]["ld_scores"],
        ldsc_env=config["envs"]["ldsc"],
        metabs=LDSC_METABOLITES, datasets=DATASETS
    conda:  config["envs"]["r"]
    script: "scripts/02_ldsc_rg.R"

# =========================================================
# Steps 3-8 — DEFERRED (out of today's scope: Steps 0-2 only).
# The rules below are commented out because they reference config keys that are
# intentionally still disabled (ref.geno_panel, ref.eqtl_dataset, metabolites.*.
# cis_genes / coloc_locus). To restore: un-comment those keys in config/config.yaml,
# re-enable CIS_PAIRS near the top, then strip the leading '# ' from this block.
# NOTE: the MR rules (gwmr/cismr) read results/norm/{outcome}.norm.tsv.gz. That
# normalize_outcome rule was removed for the Steps 0-2 scope; restore it (it drives
# scripts/00_normalize.R, still on disk — outcome harmonization + T2D GRCh37->38 liftover)
# when re-enabling Steps 6-7.
# =========================================================
# =========================================================
# Step 3 — lead variants & loci (summary-statistics-only, no LD panel)
#   Dual MAF-dependent significance threshold + distance-based locus definition.
#   The paper's r2-based locus-merge and cross-trait clustering need a EUR genotype
#   panel (not provided by the brief) and are deferred to the LD-aware follow-on.
# =========================================================
rule lead_variants:
    input:  meta="results/meta/{metabolite}.meta.tsv.gz"
    output:
        lead="results/loci/{metabolite}.lead.tsv",
        plot="results/loci/{metabolite}.manhattan.png"
    params:
        seed=config["params"]["seed"],
        gws_p=config["params"]["gws_p"],
        rare_gws_p=config["params"]["rare_gws_p"],
        maf_rare=config["params"]["maf_rare"],
        locus_window=config["params"]["locus_window"]
    conda:  config["envs"]["r"]
    script: "scripts/03_leadvars.R"


# =========================================================
# Step 4a — LD-matrix prep for fine-mapping (per trait, wildcard-driven)
#   Trait is a wildcard; every knob comes from config[ld_prep]; the CAD-effector
#   curation is optional (config curate: 1 now, 0 later for the whole lead list).
#   Bash orchestrator (04b_make_ld.sh) driven entirely by env vars — nothing hardcoded.
#   Outputs are the two predictable files; per-locus .ld/.ld.vars/.z.tsv land in results/ld/.
# =========================================================
rule make_ld:
    input:
        lead="results/loci/{metabolite}.lead.tsv",
        meta="results/meta/{metabolite}.meta.tsv.gz",
        rhelp="workflow/scripts/04a_ld_helpers.R",
        anchors=config["ld_prep"]["anchors"]
    output:
        loci="results/ld/{metabolite}.loci.tsv",
        manifest="results/ld/{metabolite}.ld_manifest.tsv"
    params:
        window=config["ld_prep"]["window"],
        select_radius=config["ld_prep"]["select_radius"],
        maf_min=config["ld_prep"]["maf_min"],
        edge_flag_bp=config["ld_prep"]["edge_flag_bp"],
        curate=config["ld_prep"]["curate"],
        anchors=config["ld_prep"]["anchors"],
        refdir=config["ld_prep"]["refdir"]
    conda:  config["envs"]["main"]       # variantbench: bcftools + base R (Rscript); plink2 via `conda run -n plink2` (Rosetta env)
    shell:
        "TRAIT={wildcards.metabolite} "
        "WINDOW={params.window} SELECT_RADIUS={params.select_radius} "
        "MAF_MIN={params.maf_min} EDGE_FLAG_BP={params.edge_flag_bp} "
        "CURATE={params.curate} ANCHORS={params.anchors} "
        "REFDIR={params.refdir} "
        "bash workflow/scripts/04b_make_ld.sh"


# =========================================================
# Step 4c — fine-mapping (SuSiE, z-mode, one locus at a time)
# =========================================================
# Inputs are the Step-4a make_ld products (per-locus .ld/.ld.vars/.z.tsv + loci.tsv),
# NEVER the genome-wide meta — 04c reads only results/ld/<trait>.* + the lead table (for n).
# The per-locus .ld/.z files are named data-dependently, so loci.tsv (produced together with
# them by make_ld) is the DAG trigger; the script loops over it internally.
rule finemap:
    input:
        loci="results/ld/{metabolite}.loci.tsv",
        manifest="results/ld/{metabolite}.ld_manifest.tsv",
        lead="results/loci/{metabolite}.lead.tsv",
        rscript="workflow/scripts/04c_finemap.R"
    output:
        finemap="results/finemap/{metabolite}.finemap.tsv",       # per-variant PIP / CS / r2_lead
        cs="results/finemap/{metabolite}.cs_summary.tsv",         # per-CS summary, 95% + 99%, + pass_filter
        cs_filt="results/finemap/{metabolite}.cs_summary.filtered.tsv",  # CS with a genome-wide-sig variant
        qc="results/finemap/{metabolite}.susie_qc.tsv"            # convergence + kriging_s LD-mismatch
        # per-locus <trait>.<gene>.susie.rds also written (regenerable scratch; gitignored, not a DAG output)
    params:
        seed=config["params"]["seed"],
        gws_p=config["params"]["gws_p"],
        lmax=config["ld_prep"].get("finemap_L", 10)
    conda:  config["envs"]["r"]
    shell:
        "TRAIT={wildcards.metabolite} SEED={params.seed} "
        "LDDIR=results/ld OUTDIR=results/finemap "
        "LEADTSV={input.lead} "
        "GWS_P={params.gws_p} L_MAX={params.lmax} "
        "Rscript workflow/scripts/04c_finemap.R"


# ---------------------------------------------------------------
# Step 4d — annotate fine-mapped variants (missense focus, VEP REST)
# ---------------------------------------------------------------
# Converts SuSiE credible sets into biological mechanism. Reads only the 04c
# tables (never the .susie.rds; never re-fits) + the per-locus gwas.tsv (for the
# effect allele that disambiguates multiallelic VEP consequences). Pure-stdlib
# Python -> no extra install; queries GRCh38 VEP in one batch POST per 200 rsIDs.
rule annotate:
    input:
        finemap="results/finemap/{metabolite}.finemap.tsv",
        cs="results/finemap/{metabolite}.cs_summary.tsv",
        gwas="results/ld/{metabolite}.loci.tsv",   # DAG hook: per-locus gwas.tsv are named data-dependently
        pyscript="workflow/scripts/04d_annotate.py"
    output:
        annot="results/finemap/{metabolite}.annot.tsv",           # all CS variants, all consequences
        missense="results/finemap/{metabolite}.annot.missense.tsv" # the missense subset (headline)
        # <trait>.vep_raw.json also written (cached API response; regenerable scratch, gitignored)
    params:
        coverage=config["ld_prep"].get("annot_coverage", 0.95)
    conda:  config["envs"]["main"]
    shell:
        "TRAIT={wildcards.metabolite} "
        "FMDIR=results/finemap LDDIR=results/ld OUTDIR=results/finemap "
        "COVERAGE={params.coverage} "
        "python workflow/scripts/04d_annotate.py"


# ---------------------------------------------------------------
# Step 4e — fine-mapping report figures (regional + QC + consequence)
# ---------------------------------------------------------------
# Renders report figures from the persisted 04c/04d tables only (never re-fits,
# never re-queries VEP). ggplot2 + data.table (envs.r), no extra packages.
rule finemap_plots:
    input:
        finemap="results/finemap/{metabolite}.finemap.tsv",
        cs="results/finemap/{metabolite}.cs_summary.tsv",
        qc="results/finemap/{metabolite}.susie_qc.tsv",
        annot="results/finemap/{metabolite}.annot.tsv",
        rscript="workflow/scripts/04e_finemap_plots.R"
    output:
        summary="results/finemap/{metabolite}.finemap_summary.png",       # per-locus QC
        consequence="results/finemap/{metabolite}.consequence_summary.png" # coding-vs-regulatory
        # also writes plots/{trait}.{gene}.regional.png (per locus) and
        # {trait}.missense_table.png — not declared DAG outputs (count varies with loci)
    conda:  config["envs"]["r"]
    shell:
        "TRAIT={wildcards.metabolite} "
        "FMDIR=results/finemap LDDIR=results/ld OUTDIR=results/finemap "
        "Rscript workflow/scripts/04e_finemap_plots.R"
