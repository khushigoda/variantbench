# # =========================================================
# rule cismr:
#     input:
#         exposure="results/meta/{metabolite}.meta.tsv.gz",
#         outcome="results/norm/{outcome}.norm.tsv.gz"
#     output: "results/cismr/{metabolite}.{outcome}.cismr.tsv"
#     params:
